#bookmark-form fieldset {
  border: 1px solid #f6e1a2;
  background: linear-gradient(90deg, rgba(195,165,92,1) 0%, rgba(244,242,183,1) 50%, rgba(195,165,92,1) 100%) !important;
  box-shadow: none;
}

#bookmark-form fieldset h4.heading,
#bookmark-form fieldset label,
#bookmark-form fieldset p {
  color: #000;
}

div.dynamic {
  background: transparent;
}

span.unread,
.replied,
span.claimed,
.actions span.defaulted {
  background: linear-gradient(90deg, rgba(195,165,92,1) 0%, rgba(244,242,183,1) 50%, rgba(195,165,92,1) 100%) !important;
  color: #000;
  border: 1px solid #f6e1a2;
}

li.fandom.listbox.group {
  background: transparent;
  border: none;
  box-shadow: none;
}

li.fandom.listbox.group h5.heading {
  font-variant: small-caps;
  font-size: 150%;
  margin-top: 1em;
  margin-bottom: .5em;
}

li.fandom.listbox.group ul.index.group li {
  background: rgba(0,0,0,.2);
  border-radius: 5px;
  margin-bottom: .5em;
}

#stat_chart svg text {
  filter: invert(100%) sepia(150%) brightness(90%);
}

#stat_chart svg rect:first-of-type {
  filter: opacity(0%);
}

#stat_chart g[clip-path^=url] > g:nth-of-type(2) rect:nth-of-type(1),
#stat_chart g[clip-path^=url] > g:nth-of-type(2) rect:nth-of-type(2),
#stat_chart g[clip-path^=url] > g:nth-of-type(2) rect:nth-of-type(3),
#stat_chart g[clip-path^=url] > g:nth-of-type(2) rect:nth-of-type(4),
#stat_chart g[clip-path^=url] > g:nth-of-type(2) rect:nth-of-type(5),
#stat_chart svg g:nth-of-type(2) > g rect:last-of-type {
  filter: brightness(0) saturate(100%) invert(86%) sepia(40%) saturate(368%) hue-rotate(341deg) brightness(103%) contrast(93%);
}

h4.viewed.heading {
  background: rgba(0,0,0,.3);
  border-radius: 5px;
  padding: .3em;
}

dl.index dd {
  background: transparent;
  padding-bottom: .5em;
  border-bottom: 1px dashed #dad998;
  margin-bottom: 1em;
}

.child {
  background: transparent;
}

textarea {
  scrollbar-color: green beige;
  scrollbar-width: thin;
}

li.skins.own.picture.blurb.group,
li.own.collection.picture.blurb.group,
dl.assignment.index.group {
  background: rgba(0,0,0,.3);
  border-radius: 8px 8px 0px 0px;
}

dl.assignment.index.group {
  padding-top: .5em;
  padding-left: .5em;
}

.requests.listbox.group,
dd.character.listbox.group,
dd.collection.listbox.group {
  background: transparent;
  border: none;
  box-shadow: none;
}

form blockquote.userstuff {
  background: linear-gradient(90deg, rgba(195,165,92,1) 0%, rgba(244,242,183,1) 50%, rgba(195,165,92,1) 100%) !important;
  color: #000 !important;
}

li.skins.own.picture.blurb.group,
li.own.collection.picture.blurb.group,
dl.signup.index.group {
  background: rgba(0,0,0,.3);
  border-radius: 8px 8px 0px 0px;
}

dl.signup.index.group {
  padding-top: .5em;
  padding-left: .5em;
}

p.muted.notice {
  display: none;
}

dl.statistics.meta.group {
  background: rgba(0,0,0,.3) url("https://64.media.tumblr.com/927e2fe48d8df6006168a4f947f52bc0/7cb0e66a9650a61b-47/s640x960/6d74753c777b9d1c10b18c996e3aa892ec7016b5.png");
  background-repeat: no-repeat;
  background-position: bottom right;
  background-size: auto 60%;
}

ul.tags.commas {
  padding-bottom: 1em;
  border-bottom: 1px dashed #f6e1a2;
  margin-bottom: 1em;
}
